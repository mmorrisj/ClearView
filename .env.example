# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgresql+psycopg://clearview:clearview@localhost:5432/clearview
LOG_LEVEL=INFO
# Disposable database for pytest; tests wipe it. Must differ from DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://clearview:clearview@localhost:5432/clearview_test
# YouTube Data API v3 key (Google Cloud Console). Required for `lt discover youtube`.
YOUTUBE_API_KEY=
